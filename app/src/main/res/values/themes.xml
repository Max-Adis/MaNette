<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme – fond blanc, textes sombres -->
    <style name="Theme.MaNette" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/manette_blue</item>
        <item name="colorPrimaryVariant">@color/manette_blue_deep</item>
        <item name="colorSecondary">@color/manette_blue_light</item>
        <item name="android:colorBackground">@color/bg_screen</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Splash theme -->
    <style name="Theme.MaNette.Splash" parent="Theme.MaNette">
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Fullscreen (Gamepad) -->
    <style name="Theme.MaNette.Fullscreen" parent="Theme.MaNette">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Card style -->
    <style name="Widget.MaNette.GlassCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/manette_white</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Primary Button -->
    <style name="Widget.MaNette.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/manette_blue</item>
        <item name="android:textColor">@color/text_on_button</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Gamepad button -->
    <style name="Widget.MaNette.GamepadButton" parent="android:style/Widget.Button">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_on_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">8dp</item>
    </style>

</resources>
