<?xml version="1.0" encoding="utf-8"?>
<!-- Corps de la manette : blanc avec ombre bleue douce et coins arrondis -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ombre portée -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A3D6A9E" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Corps blanc principal -->
    <item
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="32dp" />
            <stroke android:width="1.5dp" android:color="#D0E4F7" />
        </shape>
    </item>
</layer-list>
