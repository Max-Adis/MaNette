<?xml version="1.0" encoding="utf-8"?>
<!-- Gamepad button base - circular -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#0F2E6B" />
            <stroke android:width="2dp" android:color="#93C5FD" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1D4ED8" />
            <stroke android:width="1.5dp" android:color="#60A5FA" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>
</selector>
