<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen landscape gamepad - Boutons photoréalistes agrandis + Effet enfoncé visible à l'appui + Sticks 3D au centre -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:keepScreenOn="true">

    <!-- 1. IMAGE DE LA MANETTE – fond plein écran -->
    <ImageView
        android:id="@+id/imgController"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/manette"
        android:scaleType="fitCenter" />

    <!-- 2. OVERLAY PRINCIPAL – Zones invisibles au repos + Effet enfoncé visible lors de l'appui -->
    <com.manette.app.views.GamepadOverlayLayout
        android:id="@+id/overlayLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Touches Gâchettes L et R (invisibles au repos, effet enfoncé à l'appui) -->
        <com.manette.app.views.GamepadButtonView
            android:id="@+id/btnL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.0420,0.1289,0.2539,0.2312" />

        <com.manette.app.views.GamepadButtonView
            android:id="@+id/btnR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.0420,0.6172,0.2539,0.2312" />

        <!-- Grand D-Pad en haut à gauche (invisible au repos, branche enfoncée visible à l'appui) -->
        <com.manette.app.views.DPadView
            android:id="@+id/dpadView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.3012,0.1191,0.1758,0.3152" />

        <!-- Grands boutons Y, X, B, A en haut à droite (invisibles au repos, effet enfoncé à l'appui) -->
        <com.manette.app.views.GamepadButtonView
            android:id="@+id/btnY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.2382,0.7480,0.0898,0.1611" />

        <com.manette.app.views.GamepadButtonView
            android:id="@+id/btnX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.3678,0.6699,0.0898,0.1611" />

        <com.manette.app.views.GamepadButtonView
            android:id="@+id/btnB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.3678,0.8223,0.0898,0.1611" />

        <com.manette.app.views.GamepadButtonView
            android:id="@+id/btnA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.4904,0.7461,0.0898,0.1611" />

        <!-- Boutons centraux SELECT et START -->
        <com.manette.app.views.GamepadButtonView
            android:id="@+id/btnSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.3958,0.4102,0.0645,0.0595" />

        <com.manette.app.views.GamepadButtonView
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.3958,0.5117,0.0645,0.0595" />

        <!-- Sticks Analogiques 3D resserrés au milieu en bas -->
        <com.manette.app.views.VirtualJoystickView
            android:id="@+id/leftJoystick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.4650,0.3050,0.1750,0.3100" />

        <com.manette.app.views.VirtualJoystickView
            android:id="@+id/rightJoystick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="0.4650,0.5200,0.1750,0.3100" />

    </com.manette.app.views.GamepadOverlayLayout>

    <!-- 3. BARRE DE STATUT (discrète + bouton Paramètres haptiques) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#22000000">

        <View
            android:id="@+id/gpStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/ic_status_dot" />

        <TextView
            android:id="@+id/tvGpStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/status_connected"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDebug"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="HID"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#AAFFFFFF"
            app:cornerRadius="8dp"
            android:paddingHorizontal="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:text="⚙"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#AAFFFFFF"
            app:cornerRadius="8dp"
            android:paddingHorizontal="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:text="⌂"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- 4. OVERLAY DEBUG HID -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDebug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◆ HID REPORT DEBUG"
                android:textSize="10sp"
                android:textColor="#00FF7F"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHidReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Buttons: 0x00 | DPad: CENTER&#10;L.JS: (0,0) | R.JS: (0,0)"
                android:textSize="11sp"
                android:textColor="#00FF7F"
                android:fontFamily="monospace" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
