<?xml version="1.0" encoding="utf-8"?>
<!-- Center button (SELECT/START) – style pilule bleu-gris pâle -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#2A4F7C"
                android:endColor="#3D6A9E" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#6A9FD4" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#8AAFD0"
                android:endColor="#6A8DB8" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
</selector>
