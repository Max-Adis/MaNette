<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton L/R (shoulder) – bleu foncé avec dégradé, style plastique -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1E3D60"
                android:endColor="#2A4F7C" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#5B8EC0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#3D6A9E"
                android:endColor="#2A4F7C" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#6A9FD4" />
        </shape>
    </item>
</selector>
